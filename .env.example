# Root .env — read by docker-compose.yml only (Postgres + Redis containers).
# Copy to .env. If .env is absent, the defaults in docker-compose.yml apply.
#
# The server and client have their own .env files:
#   server/.env.example  → server/.env
#   client/.env.example  → client/.env
# Application secrets live in server/.env, NOT here.

PG_USER=autodb_user
PG_PASSWORD=autodb_pass
PG_DATABASE=autodb

# Host-side ports. Change these if something else already owns 5432 / 6379,
# and mirror the change in server/.env (PG_PORT).
PG_PORT=5432
REDIS_PORT=6379
