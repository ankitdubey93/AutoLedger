# Copy to server/.env before running `npm run dev`.
# PG_* must match the credentials the root .env feeds docker-compose.yml.

NODE_ENV=development
PORT=5000

# CORS allow-list origin. The server refuses to boot without it.
FRONTEND_URL=http://localhost:5173

PG_HOST=localhost
PG_PORT=5432
PG_USER=autodb_user
PG_PASSWORD=autodb_pass
PG_DATABASE=autodb

# Redis — background jobs and the webhook dispatcher (Phase 7).
# Optional: these defaults match docker-compose.yml.
REDIS_HOST=localhost
REDIS_PORT=6379
# Database index. The test suite pins itself to index 1 so `npm test`
# can flush its own keys without touching your dev queues.
REDIS_DB=0

# Phase 9.5 — the Document Vault's filesystem backend. Optional; defaults to
# server/storage. Gitignored, and it does NOT survive a multi-instance
# deployment — storageService keeps a narrow put/get/stat interface so object
# storage is a one-file swap later.
STORAGE_ROOT=storage

# Phase 10 — AP-Flow's vision extraction. Optional: the server and the worker
# both boot without it, and every test stubs the vision client. Leaving this
# unset makes extraction return 503 while everything else in AP-Flow (upload,
# rasterization, local OCR, PII masking) keeps working.
ANTHROPIC_API_KEY=

# REQUIRED since Phase 1. The server refuses to boot without both, and they
# must be at least 32 characters and DIFFERENT from each other — one shared key
# would let a 7-day refresh token authenticate as an access token.
#
# Generate two independent values:
#   openssl rand -hex 32
#   openssl rand -hex 32
#
# There is no JWT_SECRET — see docs/guardrails.md rule 11.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
