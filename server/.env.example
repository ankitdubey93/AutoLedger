# Copy to server/.env before running `npm run dev`.
# PG_* must match the credentials the root .env feeds docker-compose.yml.

NODE_ENV=development
PORT=5000

# CORS allow-list origin. The server refuses to boot without it.
FRONTEND_URL=http://localhost:5173

PG_HOST=localhost
PG_PORT=5432
PG_USER=autodb_user
PG_PASSWORD=autodb_pass
PG_DATABASE=autodb

# Redis — background jobs and the webhook dispatcher (Phase 7).
# Optional: these defaults match docker-compose.yml.
REDIS_HOST=localhost
REDIS_PORT=6379
# Database index. The test suite pins itself to index 1 so `npm test`
# can flush its own keys without touching your dev queues.
REDIS_DB=0

# Phase 9.5 — the Document Vault's filesystem backend. Optional; defaults to
# server/storage. Gitignored, and it does NOT survive a multi-instance
# deployment — storageService keeps a narrow put/get/stat interface so object
# storage is a one-file swap later.
STORAGE_ROOT=storage

# Phase 10 — AP-Flow's vision extraction. Optional: the server and the worker
# both boot without it, and every test stubs the vision client. Leaving this
# unset makes extraction return 503 while everything else in AP-Flow (upload,
# rasterization, local OCR, PII masking) keeps working.
ANTHROPIC_API_KEY=

# Phase 19 — which vision/classification provider AP-Flow uses: anthropic |
# gemini. Optional; defaults to anthropic. Only the selected provider's key
# is needed. Gemini is called over fetch, no SDK.
AP_FLOW_AI_PROVIDER=anthropic
# Google AI Studio / Gemini API key. Optional.
GEMINI_API_KEY=
# Pinned deliberately rather than using the floating `gemini-flash-latest`
# alias — a model must not change under a live ledger without a diff.
# Retiring one is scheduled maintenance: `gemini-2.5-flash` returned 404
# "no longer available to new users" on 2026-09-14.
AP_FLOW_GEMINI_MODEL=gemini-3.6-flash

# Phase 19.3 — the Drive integration (docs/development.md#setting-up-drive-intake
# has the full walkthrough). All optional: the server and worker both boot
# without any of them.
#
# RECOMMENDED: a service account. No consent screen, no Google app
# verification, no refresh-token expiry. Set up in Google Cloud Console:
# enable the Drive API, create a service account, download its JSON key, and
# copy client_email / private_key below. The tenant shares a Drive folder
# with GOOGLE_SERVICE_ACCOUNT_EMAIL directly — no OAuth flow at all.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the JSON key's "private_key" field exactly as written, \n escapes
# included — do not insert real newlines. Must start with
# -----BEGIN PRIVATE KEY----- (PKCS#8) or the server refuses to boot.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# SECONDARY (Phase 19.2) — OAuth 2.0 + PKCE, for a Workspace tenant whose
# admin blocks sharing to an external service-account address. Set up in
# Google Cloud Console: configure the OAuth consent screen, create a Web
# application OAuth client, and add GOOGLE_OAUTH_REDIRECT_URI as an
# authorized redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# CHANGED IN 19.3: moved from /api/v1/ap-flow/drive/... — the old path still
# answers as a legacy alias, but point a new setup at this one.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/v1/integrations/drive/oauth/callback
# AES-256-GCM key for the OAuth path's refresh tokens/PKCE verifiers at rest
# — 64 hex chars. Not needed for the service-account path above.
# Generate with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

# REQUIRED since Phase 1. The server refuses to boot without both, and they
# must be at least 32 characters and DIFFERENT from each other — one shared key
# would let a 7-day refresh token authenticate as an access token.
#
# Generate two independent values:
#   openssl rand -hex 32
#   openssl rand -hex 32
#
# There is no JWT_SECRET — see docs/guardrails.md rule 11.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
