# Copy to server/.env before running `npm run dev`.
# PG_* must match the credentials the root .env feeds docker-compose.yml.

NODE_ENV=development
PORT=5000

# CORS allow-list origin. The server refuses to boot without it.
FRONTEND_URL=http://localhost:5173

PG_HOST=localhost
PG_PORT=5432
PG_USER=autodb_user
PG_PASSWORD=autodb_pass
PG_DATABASE=autodb

# Consumed from Phase 1 onward (auth). Nothing reads them yet, so they are not
# required at boot until then. Generate real values with:
#   openssl rand -hex 32
# There is no JWT_SECRET — see docs/guardrails.md rule 8.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
