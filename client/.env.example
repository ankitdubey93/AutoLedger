# Copy to client/.env.
#
# Vite inlines VITE_-prefixed variables into the bundle at build time, so this
# value must be reachable from the *browser*. Never a Docker service name.
# Anything here is public — no secrets.

VITE_API_BASE_URL=http://localhost:5000

# Optional — the demo organization built by `npm run seed:demo` in server/.
# When both are set, the sign-in page offers "Explore the demo company".
# These are demo credentials and end up in the bundle; never use a real account.
# VITE_DEMO_EMAIL=demo@autoledger.dev
# VITE_DEMO_PASSWORD=autoledger-demo
